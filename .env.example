# ─────────────────────────────────────────────────────────────
# Sherpa Travell — admin backend config
# Copy to .env.local (local dev) and set the same values in the
# Vercel project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Admin login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=sherpatravell1212!@

# Random secret used to sign admin session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ── Data persistence: Git-as-database (no database needed) ──
# The admin API writes treks back to src/data/treks.json in your
# GitHub repo via the GitHub Contents API. Pushing to the repo
# triggers a Vercel auto-redeploy so the live site updates.
#
# Create a token at https://github.com/settings/tokens
# Scope: "Contents" (repo) write access.
GITHUB_REPO=your-username/sherpa-travell
GITHUB_TOKEN=
GITHUB_BRANCH=main

# ── Image storage: Vercel Blob (object storage, not a database) ──
# Create a Blob store in the Vercel dashboard → Storage → Blob, then
# connect it to the project. Vercel injects these automatically.
# Older flat naming is still read as a fallback:
#   BLOB_READ_WRITE_TOKEN=<old format>
BLOB_READ_WRITE_TOKEN_READ_WRITE_TOKEN=
BLOB_READ_WRITE_TOKEN_STORE_ID=
BLOB_READ_WRITE_TOKEN_WEBHOOK_PUBLIC_KEY=
